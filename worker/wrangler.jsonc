// Larry's send Worker. Other Workers bind to it as a service and call send(), sendDirect(),
// enqueue() and enqueueDirect(); see the README's "Sending messages from other apps".
// It has no fetch handler, so it isn't reachable from the internet.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indy-larry",
  "account_id": "afd63515948c9b2188ce14ef1504b2c1",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // SEND_CHANNELS (name:channelId,...) isn't set here: build-and-deploy.yml passes it from the
  // ENV_SEND_CHANNELS repo variable with --var. DISCORD_TOKEN is a Worker secret set by the same deploy.
  // GUILD_ID and CHANNEL_CATEGORIES (roles and channels) are passed the same way, from repo variables.
  // For wrangler dev, put them all in .dev.vars (see .dev.vars.example).
  "queues": {
    "producers": [{ "binding": "LARRY_QUEUE", "queue": "larry-messages" }],
    "consumers": [
      {
        "queue": "larry-messages",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        // One batch at a time keeps the queue inside Discord's rate limits.
        "max_concurrency": 1,
        "dead_letter_queue": "larry-messages-dlq"
      }
    ]
  }
}
