# For wrangler dev: copy to .dev.vars and fill in. Use a test server's token and channels.
# Larry's bot token (the same one the VPS bot uses)
DISCORD_TOKEN=
# Channels callers may post to, as name:channelId, comma-separated, e.g. events:111,training:222
SEND_CHANNELS=
# The server whose roles and channels callers may manage
GUILD_ID=
# Categories callers may create channels under and post into by ID, as name:categoryId, e.g. training:333
CHANNEL_CATEGORIES=
