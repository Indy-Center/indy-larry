# For wrangler dev: copy to .dev.vars and fill in. Use a test server's token and channels.
# Larry's bot token (the same one the VPS bot uses)
DISCORD_TOKEN=
# Channels callers may post to, as name:channelId, comma-separated, e.g. events:111,training:222
SEND_CHANNELS=
# The server whose roles and channels callers may manage
GUILD_ID=
# Categories callers may create channels under and post into by ID, as name:categoryId, e.g. training:333
CHANNEL_CATEGORIES=
# Channel errors are reported in (#larry-errors); blank sends nothing
ERROR_CHANNEL_ID=
# The secret larry's bot sends to POST /bot/events (BOT_EVENTS_SECRET in the bot's .env); any made-up value locally
BOT_EVENTS_SECRET=
# The secret teamspeak-bot sends to its /teamspeak/ routes (LARRY_SECRET in teamspeak-bot's .env); any made-up value locally
TEAMSPEAK_BOT_SECRET=
# The role sync's client at identity, registered with the users:read and users:write scopes
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
# The training app's group sync: off (or blank), dry-run or live
GROUP_SYNC_TRAINING=
