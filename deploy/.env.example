# The variables the bot reads at runtime. Names only; never put values here.
# On the VPS each one is a repo secret (or, if it isn't secret, a repo variable) named ENV_<NAME>:
# ENV_DISCORD_TOKEN becomes DISCORD_TOKEN in the .env the deploy writes.
# For local development, copy this to .env in the repo root and fill it in.

# Required. Bot token from https://discord.com/developers/applications (secret)
DISCORD_TOKEN=
# Required. Channel the status embeds are posted in (right-click the channel > Copy Channel ID)
CHANNEL_ID=
# Comma-separated ARTCCs to show, e.g. ZID. Blank shows every ARTCC and turns off bookings.
ARTCC_IDS=

# Optional; the defaults are in brackets.
# How often to check the feed, in seconds, minimum 15 [30]
POLL_SECONDS=
# Show controllers who are connected but not active on frequency [false]
INCLUDE_INACTIVE=
# Show real names; false shows CIDs only [true]
SHOW_NAMES=
# Blue "planned" embed when a booking starts within this many hours [3]
PLANNED_HOURS=
# Yellow "closing" when every controller is closing within this many minutes [15]
CLOSING_MINUTES=
# Keep a red "offline" embed this many minutes after a facility closes; 0 removes it right away [30]
OFFLINE_MINUTES=

# Notification panels: relief/staffing roles and Iron Mic. All blank turns them off.
# Channel the three panels are posted in; must not be CHANNEL_ID
PANEL_CHANNEL_ID=
# Channel break/staffing requests are posted in; must not be CHANNEL_ID [PANEL_CHANNEL_ID]
ALERT_CHANNEL_ID=
# Relief panel drop-downs as Label:roleId, comma-separated, in order, e.g.
# S Ground:111,A Ground:222,S Local:333,A Local:444,T Radar:555,E Radar:666
RELIEF_ROLES=
# Roles a Break/Staffing request in each area can ping, as Label:roleId like RELIEF_ROLES, e.g.
# CAB_ROLES=S-GC:111,A-GC:222,S-LC:333,A-LC:444  TRACON_ROLES=T-RC:555  ENROUTE_ROLES=E-RC:666
# An area left blank is left off the panel; all three blank leaves the panel out.
CAB_ROLES=
TRACON_ROLES=
ENROUTE_ROLES=
# Grey out a Break/Staffing alert nobody has claimed after this many minutes; 0 keeps it open [60]
REQUEST_EXPIRE_MINUTES=
# Role the Iron Mic button toggles, also pinged when /ironmic start runs; blank leaves that panel out and pings nobody
IRON_MIC_ROLE_ID=
# Channel the /ironmic leaderboard is posted in, e.g. a test channel [CHANNEL_ID, above the status embeds]
IRON_MIC_CHANNEL_ID=

# Aircraft on frequency: one embed in CHANNEL_ID listing every online position with the aircraft tuned to it
# (guard excluded). An aircraft counts when it is on the frequency and within range of the controller's radio,
# so the same frequency at another airport doesn't count. true turns it on [false]
TRAFFIC_ENABLED=
# How far from the controller an aircraft can be and still count, in nautical miles [10, 60, 250]
TRAFFIC_RADIUS_CAB=
TRAFFIC_RADIUS_TRACON=
TRAFFIC_RADIUS_ENROUTE=
# Busy frequency alert, posted in ALERT_CHANNEL_ID when a position reaches this many aircraft. 0 or blank turns
# it off for that area (CAB = delivery, ground and tower). Needs TRAFFIC_ENABLED and the panels.
HELP_THRESHOLD_CAB=
HELP_THRESHOLD_TRACON=
HELP_THRESHOLD_ENROUTE=
# Role the alert pings and the Busy frequency button toggles; blank pings nobody and leaves the button out
HELP_ROLE_ID=
# Minutes before the same position can alert again [15]
HELP_COOLDOWN_MIN=
# The count has to drop this far below the threshold before the position can alert again [2]
HELP_HYSTERESIS=

# Sending messages from other apps. Read by the Worker in worker/ (build-and-deploy.yml passes it there); the VPS bot ignores it.
# Channels other Workers may post to through Larry, as name:channelId, comma-separated, e.g.
# events:111,training:222. Callers use the name; any other channel is refused. Must not include CHANNEL_ID.
SEND_CHANNELS=
