# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Channel the status embeds are posted in (right-click channel > Copy Channel ID)
CHANNEL_ID=
# Comma-separated ARTCCs to show; leave blank for all
ARTCC_IDS=ZID
# How often to check the feed (minimum 15)
POLL_SECONDS=30
# Show controllers who are connected but not active on frequency
INCLUDE_INACTIVE=false
# Show real names (false = CID only)
SHOW_NAMES=true
# Show a blue "planned" embed when a booking starts within this many hours (needs ARTCC_IDS)
PLANNED_HOURS=3
# Turn yellow "closing" when every controller's booking ends within this many minutes
CLOSING_MINUTES=15
# Keep a red "offline" embed this many minutes after a facility closes (0 = remove right away)
OFFLINE_MINUTES=30
